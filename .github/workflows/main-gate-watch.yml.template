# Files an issue the moment the default branch's gate goes red.
#
# COPY-TO-ADAPT TEMPLATE (project-scaffolding#222). Copy this file to
# `.github/workflows/main-gate-watch.yml` in the adopting repo and replace the
# one `__GATE_WORKFLOW_NAME__` token (two sites: the `workflows:` trigger and
# the `GATE_WORKFLOW` env var) with the *name:* of the workflow that gates
# pushes to `main` — e.g. `e2e`, `verify-before-ship`, `ci`. The `.template`
# suffix is what keeps this file inert until then: GitHub Actions only loads
# `.yml`/`.yaml` under `.github/workflows/`.
#
# PRECONDITION — READ BEFORE COPYING. A `workflow_run` watcher can only observe
# a gate that actually runs in GitHub Actions on pushes to the default branch.
# A repo whose gate is local-only (a `verify-before-ship` / pytest run on the
# developer's machine) gets ZERO coverage from this file: it will never fire,
# and installing it produces a false sense of coverage — which is the failure
# this workflow exists to prevent, not a cheap version of the fix. Such a repo
# has no automated red-main detection; say so rather than assuming green (see
# the decision recorded on project-scaffolding#222).
#
# WHY THIS EXISTS. CI is advisory in this fleet — the local gate (pytest/ruff/
# mypy, CLAUDE.md) is the real contract — but a red main should never rely on
# someone noticing it by accident while reviewing an unrelated PR. That is
# exactly how whatsapp-radar#258's Gmail idempotency regression went unreported
# for four days: two markdown-only PRs correctly discounted the red gate for
# their own diffs, and nobody treated "main is red" as a finding in its own
# right. Three fleet repos were found sitting on a broken main in a single day
# (2026-08-15) for the same reason. This watches only runs of the gate workflow
# triggered by a push to `main` itself — PR runs are excluded by the
# `branches: [main]` filter below, since a PR's own gate is already visible in
# its own checks.
name: main-gate-watch

on:
  workflow_run:
    workflows: ["__GATE_WORKFLOW_NAME__"]
    types: [completed]
    branches: [main]

permissions:
  issues: write

jobs:
  report-red-main:
    if: ${{ github.event.workflow_run.conclusion == 'failure' }}
    runs-on: ubuntu-latest
    steps:
      - name: File (or update) the red-main tracking issue
        env:
          GH_TOKEN: ${{ github.token }}
          GATE_WORKFLOW: __GATE_WORKFLOW_NAME__
          RUN_URL: ${{ github.event.workflow_run.html_url }}
          RUN_SHA: ${{ github.event.workflow_run.head_sha }}
          OWNER: ${{ github.repository_owner }}
        run: |
          set -e
          gh label create ci-red-main \
            --repo "$GITHUB_REPOSITORY" \
            --color d73a4a \
            --description "main's ${GATE_WORKFLOW} gate failed on a push to main" \
            --force

          existing="$(gh issue list --repo "$GITHUB_REPOSITORY" \
            --label ci-red-main --state open --json number --jq '.[0].number')"

          if [ -n "$existing" ]; then
            gh issue comment "$existing" --repo "$GITHUB_REPOSITORY" \
              --body "Still red on main at ${RUN_SHA}: ${RUN_URL}"
          else
            body="$(printf 'The `%s` workflow failed on a direct push to `main`.\n\nRun: %s\nCommit: %s\n\nFiled automatically the first time this was observed. A markdown-only or otherwise-unrelated PR is entitled to discount this as unrelated to its own diff, but that is a separate finding from this one being fixed — leave this issue open until main is green again, and close it (with a note on root cause) once it is.' "$GATE_WORKFLOW" "$RUN_URL" "$RUN_SHA")"
            gh issue create --repo "$GITHUB_REPOSITORY" \
              --title "main's ${GATE_WORKFLOW} gate is red" \
              --label bug --label ci-red-main \
              --assignee "$OWNER" \
              --body "$body"
          fi
