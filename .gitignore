# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# e2e test runtime artefact (written by tests/_streamlit_lifecycle.py)
tests/_streamlit_restart_marker.txt

# Virtual env
.venv/
venv/

# Streamlit
.streamlit/secrets.toml

# Project working data
data/logs/*
data/output/*
data/input/*
!data/logs/.gitkeep
!data/output/.gitkeep
!data/input/.gitkeep

# IDE
.vscode/
.idea/
*.swp

# Agent-local context and generated scoped discovery links (all depths).
# Ignored does not mean disposable: preserve real directories and private skills.
# Share only reviewed canonical skill sources with narrow per-skill exceptions;
# see docs/agents/project-skills.md. Never unignore whole context directories.
# AGENTS.md and CLAUDE.md are committed instruction artifacts, not ignored.
.claude/
.agents/
.codex/
.pi/
.grok/

# Launcher scratch (ephemeral images/logs written by the tray launcher)
.launcher-tmp/

# Runtime log files, including the tray's webapp/watchdog.log breadcrumb trail
# (app/tray/watchdog.py's BreadcrumbLog + its rotated .log.1). See
# docs/windows-tray.md gotcha #5 — these are per-machine diagnostics, never
# committed.
*.log
*.log.1

# OS
.DS_Store
Thumbs.db
